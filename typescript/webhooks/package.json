{
  "name": "@cimento/webhooks",
  "version": "0.1.1",
  "description": "Verify webhooks sent by Cimento and read them as typed events.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cimento-AI/cimento-sdk.git",
    "directory": "typescript/webhooks"
  },
  "homepage": "https://docs.cimento.ai/webhooks/overview",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit && tsup && publint && attw --pack . && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.19.2",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "vitest": "^5.1.1"
  }
}
